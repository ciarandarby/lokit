include stubs/*.pyi
include native/interchange/build.rs
include native/interchange/Cargo.lock
include native/interchange/Cargo.toml
include native/lokit-format/Cargo.lock
include native/lokit-format/Cargo.toml
include src/lokit/_interchange_rust.pyi
include src/lokit/office/process.py
include src/lokit/office/runtime.py
include src/lokit_office_runtime/runtime.json
include tools/smoke_test_wheel.py
include tools/stage_office_runtime.py
include tools/verify_native_install.py
include tools/verify_release_versions.py
include tools/verify_sdist_contents.py
recursive-include native/interchange/src *.rs
recursive-include native/lokit-format/src *.rs
prune .sdist-source
prune .sdist-smoke
prune sdist-wheel
prune src/lokit_office_runtime/bin
global-exclude *.a *.com *.dll *.dylib *.exe *.lib *.msi *.o *.obj *.pyd *.so *.so.*
