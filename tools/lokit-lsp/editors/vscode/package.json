{
  "name": "lokit-language-client",
  "displayName": "Lokit Language Client",
  "description": "Semantic highlighting, diagnostics, navigation, and formatting for .lokit interchange files",
  "version": "0.2.0",
  "publisher": "lokit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ciarandarby/lokit.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:lokit"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "bundle": "esbuild extension.js --bundle --format=cjs --minify --outfile=dist/extension.js --platform=node --external:vscode",
    "package": "npm run bundle && vsce package"
  },
  "contributes": {
    "languages": [
      {
        "id": "lokit",
        "aliases": [
          "Lokit",
          "lokit"
        ],
        "extensions": [
          ".lokit"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configurationDefaults": {
      "[lokit]": {
        "editor.defaultFormatter": "lokit.lokit-language-client",
        "editor.formatOnSave": true,
        "editor.semanticHighlighting.enabled": true
      }
    },
    "configuration": {
      "title": "Lokit",
      "properties": {
        "lokit.server.path": {
          "type": "string",
          "default": "lokit-lsp",
          "description": "Path to the lokit-lsp executable."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.25.8"
  }
}
